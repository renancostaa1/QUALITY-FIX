# Quality Fix Analytics — fonte de dados (ERP)
# Copie para ".env" e preencha. O ".env" real NUNCA deve ser versionado nem sincronizado (Git/OneDrive).
# Estas variáveis são lidas só pelo servidor (API). Nada daqui vai para o navegador.

# ── Conexão com o banco do ERP (usuário SOMENTE LEITURA) ──────────────
# Motor do banco: mysql | mssql | postgres  (a confirmar — o SQL das views não deixa claro)
DB_CLIENT=
DB_HOST=
# Portas padrão: mysql/mariadb 3306 · mssql 1433 · postgres 5432
DB_PORT=
DB_NAME=
# Usuário com SELECT apenas nas views abaixo (sem acesso às tabelas TAB_*)
DB_USER=
DB_PASSWORD=
DB_SSL=false
DB_CONNECT_TIMEOUT_MS=10000

# ── Views consumidas pelo painel ──────────────────────────────────────
VIEW_CLIENTES=VW_CLIENTES
# Confirmar o nome real: o SQL enviado para pedidos não tem CREATE VIEW
VIEW_PEDIDOS=VW_PEDIDOS
VIEW_PRODUTOS=VW_PRODUTOS
# Ainda não existem (necessárias para faturamento por produto/divisão e cotações)
VIEW_ITENS_PEDIDO=
VIEW_COTACOES=

# ── Regras de negócio ─────────────────────────────────────────────────
# Dias sem comprar para o cliente virar inativo
DIAS_PARA_INATIVAR=90
# Sem fonte no ERP hoje: valor fixo (R$ por mês) usado em "Faturamento vs Meta"
META_MENSAL_EMPRESA=3090000
# Códigos dos vendedores internos, separados por vírgula (ou usar um flag na view)
VENDEDORES_INTERNOS_COD=

# ── API do painel ─────────────────────────────────────────────────────
API_PORT=3001
# URL onde o painel será hospedado (origem autorizada a chamar a API)
API_ALLOWED_ORIGIN=http://localhost:3000
# Token exigido pelo painel em cada chamada à API
API_TOKEN=
# Cache das consultas, em segundos, para não pesar no ERP
CACHE_TTL_SECONDS=300
